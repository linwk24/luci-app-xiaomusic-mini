#!/bin/sh
# 输出 xiaomusic-mini 运行日志（供 LuCI 页面查看）
# 用法: xiaomusic-mini-log [行数]     默认 120 行

CONF=/opt/xiaomusic-mini/config.json
DEFAULT_LOG=/opt/xiaomusic-mini/xiaomusic-mini.log
N="${1:-120}"

case "$N" in
	''|*[!0-9]*) N=120 ;;
esac

LOG=""
if [ -f "$CONF" ] && command -v python3 >/dev/null 2>&1; then
	LOG="$(python3 -c "import json,sys;print(json.load(open(sys.argv[1],encoding='utf-8')).get('log_file') or '')" "$CONF" 2>/dev/null)"
fi
[ -n "$LOG" ] || LOG="$DEFAULT_LOG"

if [ ! -f "$LOG" ]; then
	echo "(日志文件不存在: $LOG)"
	exit 0
fi

tail -n "$N" "$LOG"
